generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Users {
  ADMIN
  USER
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  EMAIL
  DATE
  SELECT
  RADIO
  CHECKBOX
  FILE
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
}

enum MailStatus {
  PENDING
  SENT
  FAILED
}

// the user table 

model User {
  id          String       @id @default(cuid())
  username    String
  email       String       @unique
  role        Users        @default(USER)
  profile     Profile?
  password    String
  department  Department?
  forms       Form[]       @relation("CreatedForms")
  updatedAt   DateTime     @updatedAt
  createdAt   DateTime     @default(now())
  submissions Submission[]
  editedHistories SubmissionEditHistory[] @relation("EditedHistories")
}

// user profile table
model Profile {
  id     String  @id @default(cuid())
  bio    String?
  avatar String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// departments tabel 
// one user per department will be register here 
model Department {
  id              String       @id @default(cuid())
  department_Name String       @unique
  userId          String?      @unique
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  formAccess      FormAccess[]
  submission      Submission[]
}

//this will have the forms 

model Form {
  id          String       @id @default(cuid())
  title       String       
  slug        String       @unique
  description String?
  isOpen      Boolean      @default(true)
  deadline    DateTime?
  createdById String?
  createdBy   User?        @relation("CreatedForms", fields: [createdById], references: [id], onDelete: SetNull)
  sections    FormSection[]
  accesses    FormAccess[]
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model FormSection {
  id String @id @default(cuid())

  formId String
  form   Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  headerLabel String?
  headerDescription String?

  title String
  description String?
  sortOrder Int @default(0)

  fields Field[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// FORM FIELDS
//

model Field {
  id String @id @default(cuid())

  sectionId String
  section   FormSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  label String

  fieldKey String

  fieldType FieldType

  placeholder String?

  required Boolean @default(false)

  sortOrder Int @default(0)

  defaultValue String?

  submissionValues SubmissionValue[]

  options FieldOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, fieldKey])
}

// FIELD OPTIONS
// for select/radio/checkbox
//

model FieldOption {
  id String @id @default(cuid())

  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  label String
  value String

  createdAt DateTime @default(now())
}

// FORM ACCESS
// which department can access which form
//

model FormAccess {
  id String @id @default(cuid())

  formId       String
  departmentId String

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([formId, departmentId])
}

//
// SUBMISSIONS
//

model Submission {
  id String @id @default(cuid())

  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  submittedById String?
  submittedBy   User?  @relation(fields: [submittedById], references: [id], onDelete: SetNull)

  status SubmissionStatus @default(DRAFT)

  isLocked Boolean @default(false)

  submittedAt DateTime?

  submissionValue SubmissionValue[]
  editHistories   SubmissionEditHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formId, departmentId])
}

//
// SUBMISSION VALUES
//

model SubmissionValue {
  id String @id @default(cuid())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, fieldId])
}

model SubmissionEditHistory {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  editedById   String?
  editedBy     User?      @relation("EditedHistories", fields: [editedById], references: [id], onDelete: SetNull)
  changedValues String    // JSON string containing the changes
  editedAt     DateTime   @default(now())
}
